# ==============================================================
# Database Configuration
# ==============================================================
# Direct Spring Boot / JDBC Configuration (e.g., Neon DB, RDS, or Local Postgres)
POSTGRESQL_DB_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
POSTGRESQL_DB_USER=your_db_username
POSTGRESQL_DB_PASSWORD=your_db_password

# Docker Compose PostgreSQL Service Config (if running via docker compose)
POSTGRES_DB=acm
POSTGRES_USER=acmsecy
POSTGRES_PASSWORD=your_postgres_password

# ==============================================================
# SMTP Configuration (for sending verification/reset emails)
# ==============================================================
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
